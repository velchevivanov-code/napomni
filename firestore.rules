rules_version = '2';
// НАПомни — Firestore Security Rules
// Rate limiting бележка: Firestore не поддържа вградено rate limiting на ниво rules.
// За production защита срещу злоупотреба (DDoS, spam writes) използвайте:
// 1. Firebase App Check (reCAPTCHA / Play Integrity) — блокира неавторизирани клиенти
// 2. Cloud Functions с rate limiter (напр. express-rate-limit) за критични endpoints
// 3. Мониторинг чрез Firebase Alerts при необичайно висок брой заявки
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Администратори — по верифициран имейл (Google login). Трябва да съвпада с ADMINS в index.html.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['velchevivanov@gmail.com'];
    }
    // Полета, които само сървърът (Stripe webhook през Admin SDK) може да променя.
    // Клиентът никога не може сам да си включи Pro.
    function billingKeys() {
      return ['plan', 'planUpd', 'stripeCustomerId', 'stripeSubscriptionId', 'stripeSubscriptionStatus'];
    }

    // Потребителски данни — само собственикът може да чете/пише (без billing полетата)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && !request.resource.data.keys().hasAny(['planUpd', 'stripeCustomerId', 'stripeSubscriptionId', 'stripeSubscriptionStatus']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingKeys());
      allow delete: if isOwner(userId);
    }

    // FCM токени — документът се казва като токена; само собственикът може да го създаде/обнови/изтрие
    match /fcmTokens/{tokenId} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token == tokenId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Допълнителни срокове — четене от автентикирани, запис само от admin
    match /deadlines/{deadlineId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Актуализации по Държавен вестник — четене от автентикирани, запис само от admin
    match /updates/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
